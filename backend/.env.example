PORT=8001
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:8001/api/v1
# 允许跨源调用本 API 的来源白名单（逗号分隔）。生产环境必须显式设置，禁止用 "*"：
# 否则服务会拒绝启动（本地开发可用 MOCK_MODE=true 或 NODE_ENV=development 跳过该检查）。
CORS_ORIGINS=https://app.example.com
# 前置可信反向代理的跳数（nginx=1）。限流按 X-Forwarded-For 里自右往左第 N 段取真实
# 客户端 IP，左侧的段视为客户端可伪造、不予采信。直连无代理可设 0（改用 socket IP）。
TRUSTED_PROXY_HOPS=1
# 请求体体积上限（字节，按路由分档；防廉价端点被灌大包做放大式 DoS）。
MAX_AUTH_BODY_BYTES=65536
MAX_BODY_BYTES=4194304
MAX_UPLOAD_BODY_BYTES=33554432
# readiness 探活(/readyz)限流：次/窗口/IP（0=不限）。
RATE_LIMIT_PROBE_MAX=60
# 慢请求阈值（毫秒）：响应耗时 >= 该值按 warn 记录并打 slow 标记，便于告警。0=关闭。
SLOW_REQUEST_MS=3000
# /api/v1/metrics 受保护令牌：留空则该端点禁用(404)；设置后需带 Authorization: Bearer <值>
# （或 x-metrics-token 头）才能拉取 5xx/慢请求比率等内存指标。建议设一个强随机串。
METRICS_TOKEN=

MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TEXT_MODEL=mimo-v2.5-pro
MIMO_TTS_MODEL=mimo-v2.5-tts-voicedesign
MIMO_TTS_VOICE=Mia
MIMO_TTS_FORMAT=wav
MIMO_TTS_PATH=/chat/completions
# 文本/Agent 卡片生成的单次 MiMo 调用超时（毫秒）。长阅读等重内容生成较慢，调大可避免被提前中断。
MIMO_TIMEOUT_MS=180000

MOCK_MODE=false
CHAT_HISTORY_MAX_MESSAGES=24
DATABASE_URL=postgres://listene:change-me@127.0.0.1:5432/listene
AUTH_TOKEN_SECRET=change-me
AUTH_TOKEN_DAYS=30
